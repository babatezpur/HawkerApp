<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewFlipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Screen 1: Phone Number Input -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btn_back_phone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title_phone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Enter your\nphone number"
            android:textColor="@color/black"
            android:textSize="28sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_back_phone" />

        <LinearLayout
            android:id="@+id/phone_input_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_phone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="+91"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/phone_edit_text"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_otp_box"
                android:hint="Phone Number"
                android:inputType="phone"
                android:maxLength="10"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Spacer for future social login options -->
        <Space
            android:id="@+id/social_login_space"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/request_otp_button"
            app:layout_constraintTop_toBottomOf="@id/phone_input_row" />

        <Button
            android:id="@+id/request_otp_button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_green_button"
            android:text="Continue  →"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ProgressBar
            android:id="@+id/loading_spinner_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/request_otp_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Screen 2: OTP Input -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btn_back_otp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title_otp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Enter OTP"
            android:textColor="@color/black"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_back_otp" />

        <TextView
            android:id="@+id/subtitle_otp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="We have sent you an One Time Password(OTP) on this mobile number."
            android:textColor="#666666"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_otp" />

        <LinearLayout
            android:id="@+id/otp_boxes_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/subtitle_otp">

            <EditText
                android:id="@+id/otp_digit_1"
                style="@style/OtpDigitBox"
                android:layout_width="44dp"
                android:layout_height="48dp" />

            <EditText
                android:id="@+id/otp_digit_2"
                style="@style/OtpDigitBox"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp" />

            <EditText
                android:id="@+id/otp_digit_3"
                style="@style/OtpDigitBox"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp" />

            <EditText
                android:id="@+id/otp_digit_4"
                style="@style/OtpDigitBox"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp" />

            <EditText
                android:id="@+id/otp_digit_5"
                style="@style/OtpDigitBox"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp" />

            <EditText
                android:id="@+id/otp_digit_6"
                style="@style/OtpDigitBox"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/resend_otp_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Didn't receive the OTP? Resend OTP"
            android:textColor="#666666"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/otp_boxes_row" />

        <Button
            android:id="@+id/verify_otp_button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_green_button"
            android:text="Login"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ProgressBar
            android:id="@+id/loading_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/verify_otp_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ViewFlipper>
